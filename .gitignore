# Virtual environment
.venv/
.venv_finetune/
venv/
env/

# LLaMA-Factory clone + training saves
third_party/LLaMA-Factory/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Cloned third-party toolkit (clone it separately)
PaddleOCR/

# Generated pipeline output (may include patient text)
output/

# Trained / downloaded model weights (large binaries)
models/
*.pdparams
*.pdopt
*.pdmodel
*.pdiparams
*.pdiparams.info
*.onnx
*.inference.json

# Prescription photos and fine-tune crops (private + large)
data/raw/
data/finetune/
data/glm_finetune/prescription_images/
data/glm_finetune/prescriptions.json
data/glm_finetune/labels.csv
finetune_glm/Modelfile.generated

# Regenerated RxNorm download (large; run python src\sync_rxnorm.py)
dict/rxnorm_cache.json

# Local env / secrets
.env
.env.*

# Logs and OS / IDE junk
*.log
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
